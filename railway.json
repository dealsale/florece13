{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run release",
    "startCommand": "npm start",
    "healthcheckPath": "/api/salud",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
