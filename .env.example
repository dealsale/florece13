# ── Base de datos (PostgreSQL 14+) ─────────────────────────────
DATABASE_URL=postgres://usuario:clave@localhost:5432/florece13

# URL pública de la app (se usa en el QR de cada tienda y en los links de WhatsApp)
APP_URL=http://localhost:3000

# Correos que quedan con rol de administrador al registrarse (separados por coma).
# El admin aprueba las tiendas nuevas antes de que salgan al público.
ADMIN_EMAILS=

# ── Fotos ──────────────────────────────────────────────────────
# local: se guardan en ./uploads (solo para un servidor con disco persistente)
# s3: cualquier almacenamiento compatible con S3 (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO…)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública desde donde se sirven los archivos del bucket (sin / final)
S3_PUBLIC_URL=
